<?xml version="1.0" encoding="utf-8"?>
<!-- The Patak submark (a butter drop with two cobalt eyes) as an Android
     vector drawable, copied from assets/brand/patak-submark.svg.
     108 x 108 is the adaptive icon canvas; the phone may crop everything
     outside the middle 66 dp circle, so the drop is scaled to 0.6 and
     centred: x' = 0.6 x + 24, y' = 0.6 y + 23.4. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="23.4">
        <path
            android:fillColor="@color/patak_butter"
            android:pathData="M50,6S18,44 18,64a32,32 0,0 0,64 0C82,44 50,6 50,6Z" />
        <path
            android:fillColor="@color/patak_cobalt"
            android:pathData="M35,64a5,5 0,1 0,10 0a5,5 0,1 0,-10 0Z" />
        <path
            android:fillColor="@color/patak_cobalt"
            android:pathData="M55,64a5,5 0,1 0,10 0a5,5 0,1 0,-10 0Z" />
    </group>
</vector>
