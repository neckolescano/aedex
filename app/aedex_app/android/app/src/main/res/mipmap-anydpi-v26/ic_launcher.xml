<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): a deep green background layer and the
     submark on top. The phone cuts it to its own shape (circle, squircle).
     The monochrome layer is used by Android 13 "themed icons". -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/patak_forest" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
